var SubmissionService=(function(){
  function baseRecord_(payload,user,id){var now=nowIso_();return {submission_id:id,submission_version:1,idempotency_token:String(payload.idempotencyToken||''),submitted_at:now,submitted_by:user.email,updated_at:now,updated_by:user.email,submission_type:String(payload.submissionType||'NEW'),route_key:'',target_sheet_id:'',target_sheet_tab:'',target_folder_id:'',validation_status:'PENDING',sheet_status:'PENDING',drive_status:(payload.attachments||[]).length?'PENDING':'NOT_REQUIRED',acl_status:'NOT_REQUIRED',processing_status:'RECEIVED',attachment_count:(payload.attachments||[]).length,retry_count:0,jira_issue_reference:'',last_error_code:'',last_error_message:'',completed_at:'',metadata:payload.metadata||{}};}
  function create(payload){var user=AuthService.authorize(false);payload=payload||{};if(!payload.idempotencyToken)throw ErrorService.create('VALIDATION_FAILED','Idempotency token required');var reservation=IdempotencyService.withLock(function(){var found=IdempotencyService.existing(payload.idempotencyToken);if(found)return {created:false,record:found};var next=baseRecord_(payload,user,submissionId_());next.processing_status='VALIDATING';SubmissionRepository.create(next);AuditRepository.record('SUBMISSION_CREATED',user.email,next.submission_id,null,next,{},'SUCCESS','');return {created:true,record:next};});if(!reservation.created)return clientRecord_(reservation.record);var record=reservation.record;try{var valid=ValidationService.validate(payload);record.validation_status='SAVED';record.processing_status='VALIDATED';SubmissionRepository.update(record);AuditRepository.record('VALIDATION_PASSED',user.email,record.submission_id,null,null,{},'SUCCESS','');VettingResponseRepository.save(record.submission_id,valid.answers,user);record.processing_status='ROUTING';SubmissionRepository.update(record);var route=RoutingService.resolve(valid.answers,user);setRoute_(record,route);record.processing_status='PROCESSING';SubmissionRepository.update(record);AuditRepository.record('ROUTE_SELECTED',user.email,record.submission_id,null,{routeKey:record.route_key},{},'SUCCESS','');DataSummaryRepository.verify(route);DriveRepository.verify(route.drive_folder_id);persist_(record,route,valid.attachments,user);return clientRecord_(record);}catch(error){fail_(record,error,user);throw attachId_(error,record.submission_id);}}
  function persist_(record,route,attachments,user){var driveError=null,sheetError=null;if(record.drive_status!=='SAVED'&&record.drive_status!=='NOT_REQUIRED'){try{DriveRepository.saveFiles(record.submission_id,attachments,route.drive_folder_id,user);record.drive_status='SAVED';record.processing_status='FILES_SAVED';SubmissionRepository.update(record);}catch(e){driveError=e;record.drive_status='FAILED';}}if(record.sheet_status!=='SAVED'){try{var result=DataSummaryRepository.upsert(record,route);record.sheet_status='SAVED';record.processing_status='DATA_SAVED';SubmissionRepository.update(record);AuditRepository.record('DATA_SUMMARY_'+result.action,user.email,record.submission_id,null,result,{},'SUCCESS','');}catch(e){sheetError=e;record.sheet_status='FAILED';}}record.updated_at=nowIso_();if(!driveError&&!sheetError){record.processing_status='COMPLETED';record.completed_at=nowIso_();record.last_error_code='';record.last_error_message='';}else{record.processing_status=(record.drive_status==='SAVED'||record.sheet_status==='SAVED')?'PARTIAL':'FAILED';var error=driveError||sheetError;record.last_error_code=error.code||'UNKNOWN_ERROR';record.last_error_message=String(error.message).slice(0,500);}SubmissionRepository.update(record);if(driveError||sheetError)throw driveError||sheetError;return record;}
  function setRoute_(record,route){record.route_key=String(route.route_key);record.target_sheet_id=String(route.data_summary_spreadsheet_id);record.target_sheet_tab=String(route.data_summary_tab);record.target_folder_id=String(route.drive_folder_id);}
  function fail_(record,error,user){if(!record)return;record.updated_at=nowIso_();record.updated_by=user.email;record.last_error_code=error.code||'UNKNOWN_ERROR';record.last_error_message=String(error.message||'').slice(0,500);record.processing_status=error.code==='ROUTE_NOT_FOUND'?'REQUIRES_REVIEW':(record.sheet_status==='SAVED'||record.drive_status==='SAVED'?'PARTIAL':'FAILED');if(error.code==='VALIDATION_FAILED'||error.code==='FILE_VALIDATION_FAILED')record.validation_status='FAILED';SubmissionRepository.update(record);AuditRepository.record(error.code==='VALIDATION_FAILED'?'VALIDATION_FAILED':'PROCESSING_FAILED',user.email,record.submission_id,null,null,{detail:record.last_error_message},'FAILURE',record.last_error_code);}
  function attachId_(error,id){error.submissionId=id;return error;}
  function clientRecord_(record){return {submissionId:record.submission_id,submissionVersion:Number(record.submission_version),routeKey:record.route_key,targetSheetTab:record.target_sheet_tab,processingStatus:record.processing_status,sheetStatus:record.sheet_status,driveStatus:record.drive_status,completedAt:record.completed_at,jiraIssueReference:record.jira_issue_reference};}
  function getAuthorized(id){var user=AuthService.authorize(false);var record=SubmissionRepository.find(id);if(!record||!AuthService.canEdit(user,record))throw ErrorService.create('AUTH_DENIED','Submission unavailable');record.metadata=safeJson_(record.metadata,{});var visibleRecord=JSON.parse(JSON.stringify(record));if(!user.privileged){delete visibleRecord.target_sheet_id;delete visibleRecord.target_folder_id;delete visibleRecord.last_error_message;}var files=AccessControlRepository.readTable('SubmissionFiles').filter(function(r){return r.submission_id===id;}).map(function(r){var visible={file_token:r.submission_file_id,original_filename:r.original_filename,stored_filename:r.stored_filename,mime_type:r.mime_type,size_bytes:r.size_bytes,uploaded_at:r.uploaded_at,active:r.active};if(user.privileged){visible.drive_file_id=r.drive_file_id;visible.folder_id=r.folder_id;}return visible;});return {record:visibleRecord,answers:VettingResponseRepository.find(id),files:files};}
  function correct(id,payload){var user=AuthService.authorize(false);var old=SubmissionRepository.find(id);if(!old||!AuthService.canEdit(user,old))throw ErrorService.create('AUTH_DENIED','Cannot edit submission');if(old.processing_status==='DELETED')throw ErrorService.create('VALIDATION_FAILED','Deleted submissions cannot be updated');var valid=ValidationService.validate(payload);var activeAttachmentCount=validateCorrectionFiles_(id,payload.removeFileIds||[],valid.attachments);var route=RoutingService.resolve(valid.answers,user);DataSummaryRepository.verify(route);DriveRepository.verify(route.drive_folder_id);var before=JSON.parse(JSON.stringify(old));var oldTarget={data_summary_spreadsheet_id:before.target_sheet_id,data_summary_tab:before.target_sheet_tab,drive_folder_id:before.target_folder_id};AuditRepository.record('CORRECTION_STARTED',user.email,id,before,null,{},'SUCCESS','');old.processing_status='CORRECTION_IN_PROGRESS';old.submission_version=Number(old.submission_version)+1;old.updated_at=nowIso_();old.updated_by=user.email;old.metadata=valid.metadata;old.submission_type='CORRECTION';old.validation_status='SAVED';old.sheet_status='PENDING';old.attachment_count=activeAttachmentCount;var routeChanged=String(old.route_key)!==String(route.route_key);var sheetTargetChanged=String(old.target_sheet_id)!==String(route.data_summary_spreadsheet_id)||String(old.target_sheet_tab)!==String(route.data_summary_tab);var folderTargetChanged=String(old.target_folder_id)!==String(route.drive_folder_id);var previousFolder=old.target_folder_id;setRoute_(old,route);if(folderTargetChanged){try{DriveRepository.moveFiles(id,route.drive_folder_id,user);old.drive_status='SAVED';}catch(e){old.processing_status='PARTIAL';old.last_error_code=e.code||'DRIVE_UPLOAD_FAILED';SubmissionRepository.update(old);AuditRepository.record('PROCESSING_FAILED',user.email,id,before,old,{phase:'route migration',previousFolder:previousFolder},'FAILURE',old.last_error_code);throw attachId_(e,id);}}DriveRepository.deactivateFiles(id,payload.removeFileIds||[],user);if(valid.attachments.length)old.drive_status='PENDING';SubmissionRepository.update(old);VettingResponseRepository.save(id,valid.answers,user);persist_(old,route,valid.attachments||[],user);if(sheetTargetChanged&&before.sheet_status==='SAVED'){try{DataSummaryRepository.remove(id,oldTarget);AuditRepository.record('DATA_SUMMARY_UPDATED',user.email,id,{sheetId:oldTarget.data_summary_spreadsheet_id,tab:oldTarget.data_summary_tab},{sheetId:old.target_sheet_id,tab:old.target_sheet_tab},{rerouted:true},'SUCCESS','');}catch(e){old.processing_status='PARTIAL';old.last_error_code=e.code||'SHEET_WRITE_FAILED';old.last_error_message=String(e.message).slice(0,500);SubmissionRepository.update(old);AuditRepository.record('PROCESSING_FAILED',user.email,id,before,old,{phase:'old Data Summary cleanup'},'FAILURE',old.last_error_code);throw attachId_(e,id);}}AuditRepository.record('CORRECTION_COMPLETED',user.email,id,before,old,{routeChanged:routeChanged,removedFileIds:payload.removeFileIds||[]},'SUCCESS','');return clientRecord_(old);}
  function retry(id,attachments){var user=AuthService.authorize(true);var record=SubmissionRepository.find(id);if(!record)throw ErrorService.create('VALIDATION_FAILED','Submission not found');if(['COMPLETED','REQUIRES_REVIEW','DELETED'].indexOf(record.processing_status)>=0)throw ErrorService.create('VALIDATION_FAILED','Submission is not retryable');attachments=attachments||[];if(record.drive_status==='FAILED'&&Number(record.attachment_count)>0&&!attachments.length)throw ErrorService.create('FILE_VALIDATION_FAILED','Reattach the original files for Drive retry');if(attachments.length)ValidationService.validateFiles(attachments);record.retry_count=Number(record.retry_count||0)+1;record.processing_status='PROCESSING';record.updated_by=user.email;record.updated_at=nowIso_();SubmissionRepository.update(record);AuditRepository.record('PROCESSING_RETRIED',user.email,id,null,null,{retryCount:record.retry_count},'SUCCESS','');var route={route_key:record.route_key,data_summary_spreadsheet_id:record.target_sheet_id,data_summary_tab:record.target_sheet_tab,drive_folder_id:record.target_folder_id};persist_(record,route,attachments,user);return clientRecord_(record);}
  function addJiraReference(id,reference){var user=AuthService.authorize(true);if(!/^[A-Z][A-Z0-9]+-\d+$/.test(String(reference||'')))throw ErrorService.create('VALIDATION_FAILED','Invalid Jira issue reference');var record=SubmissionRepository.find(id);if(!record)throw ErrorService.create('VALIDATION_FAILED','Submission not found');var before=record.jira_issue_reference;record.jira_issue_reference=String(reference);record.updated_at=nowIso_();record.updated_by=user.email;SubmissionRepository.update(record);AuditRepository.record('JIRA_REFERENCE_ADDED',user.email,id,{jiraIssueReference:before},{jiraIssueReference:reference},{},'SUCCESS','');return clientRecord_(record);}
  function remove(id){var user=AuthService.authorize(false);var record=SubmissionRepository.find(id);if(!record||!AuthService.canEdit(user,record))throw ErrorService.create('AUTH_DENIED','Cannot delete submission');if(record.processing_status==='DELETED')return clientRecord_(record);var before=JSON.parse(JSON.stringify(record));var phase='Data Summary removal';AuditRepository.record('SUBMISSION_DELETE_STARTED',user.email,id,before,null,{recoverable:true},'SUCCESS','');try{if(record.sheet_status!=='NOT_REQUIRED'&&record.target_sheet_id&&record.target_sheet_tab){DataSummaryRepository.remove(id,{data_summary_spreadsheet_id:record.target_sheet_id,data_summary_tab:record.target_sheet_tab});}record.sheet_status='NOT_REQUIRED';record.updated_at=nowIso_();record.updated_by=user.email;SubmissionRepository.update(record);phase='Drive file trash';if(record.drive_status!=='NOT_REQUIRED'){DriveRepository.trashFiles(id,user);}record.drive_status='NOT_REQUIRED';record.attachment_count=0;record.processing_status='DELETED';record.last_error_code='';record.last_error_message='';record.updated_at=nowIso_();SubmissionRepository.update(record);AuditRepository.record('SUBMISSION_DELETED',user.email,id,before,record,{recoverable:true},'SUCCESS','');return clientRecord_(record);}catch(error){if(phase==='Data Summary removal')record.sheet_status='FAILED';else record.drive_status='FAILED';record.processing_status='PARTIAL';record.updated_at=nowIso_();record.updated_by=user.email;record.last_error_code=error.code||'SUBMISSION_DELETE_FAILED';record.last_error_message=String(error.message||'').slice(0,500);SubmissionRepository.update(record);AuditRepository.record('SUBMISSION_DELETE_FAILED',user.email,id,before,record,{phase:phase},'FAILURE',record.last_error_code);throw attachId_(error,id);}}
  function safeJson_(value,fallback){if(typeof value==='object')return value;try{return JSON.parse(value)||fallback;}catch(e){return fallback;}}
  function validateCorrectionFiles_(id,removeTokens,newFiles){var remove={};removeTokens.forEach(function(x){remove[String(x)]=true;});var active=AccessControlRepository.readTable('SubmissionFiles').filter(function(r){return r.submission_id===id&&String(r.active).toLowerCase()==='true'&&!remove[String(r.submission_file_id)];});var policy=ConfigService.filePolicy();if(active.length+newFiles.length>policy.maxFileCount)throw ErrorService.create('FILE_VALIDATION_FAILED','Correction exceeds maximum active file count');var total=active.reduce(function(sum,r){return sum+Number(r.size_bytes||0);},0)+newFiles.reduce(function(sum,r){return sum+Number(r.size||0);},0);if(total>policy.maxTotalSizeBytes)throw ErrorService.create('FILE_VALIDATION_FAILED','Correction exceeds maximum total file size');return active.length+newFiles.length;}
  return {create:create,getAuthorized:getAuthorized,correct:correct,retry:retry,addJiraReference:addJiraReference,remove:remove};
})();
