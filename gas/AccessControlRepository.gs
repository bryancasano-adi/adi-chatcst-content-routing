var AccessControlRepository = (function () {
  function controlBook() { var id=ConfigService.require('CONTROL_SPREADSHEET_ID'); try { return SpreadsheetApp.openById(id); } catch(e) { throw ErrorService.create('CONFIGURATION_ERROR','Control spreadsheet unavailable'); } }
  function readTable(name) { var sheet=controlBook().getSheetByName(name); if (!sheet) throw ErrorService.create('CONFIGURATION_ERROR','Missing control tab: '+name); var values=sheet.getDataRange().getValues(); if (values.length < 2) return []; var headers=values[0].map(String); return values.slice(1).filter(function(r){return r.some(function(v){return v!=='';});}).map(function(row){var object={}; headers.forEach(function(h,i){object[h]=row[i];}); return object;}); }
  function employeeByEmail(email) { return readTable('Employees').filter(function(r){return normalizeEmail_(r.email)===normalizeEmail_(email);})[0] || null; }
  function activeRolesFor(email) { var now=nowIso_().slice(0,10); var employee=employeeByEmail(email); var assigned=readTable('RoleAssignments').filter(function(r){return normalizeEmail_(r.employee_email)===normalizeEmail_(email) && String(r.active).toLowerCase()==='true' && (!r.effective_from || String(r.effective_from).slice(0,10)<=now) && (!r.effective_to || String(r.effective_to).slice(0,10)>=now);}).map(function(r){return String(r.role_id);}); if (employee && employee.role_id && assigned.indexOf(String(employee.role_id))<0) assigned.push(String(employee.role_id)); return assigned; }
  function appendObject(name,object){var sheet=controlBook().getSheetByName(name);if(!sheet)throw ErrorService.create('CONFIGURATION_ERROR','Missing control tab: '+name);var headers=sheet.getRange(1,1,1,sheet.getLastColumn()).getValues()[0].map(String);sheet.appendRow(headers.map(function(h){var value=object[h];return typeof value==='object'?JSON.stringify(value):value===undefined?'':value;}));}
  return { controlBook:controlBook, readTable:readTable, appendObject:appendObject, employeeByEmail:employeeByEmail, activeRolesFor:activeRolesFor };
})();
