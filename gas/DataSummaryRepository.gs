var DataSummaryRepository=(function(){
  var required=['submission_id','submission_version','updated_at','updated_by','document_title','document_description','document_date','business_unit','process_name','document_owner','source_system','confidentiality','effective_date','tags'];
  function target_(route){var book;try{book=SpreadsheetApp.openById(String(route.data_summary_spreadsheet_id));}catch(e){throw ErrorService.create('TARGET_SHEET_UNAVAILABLE','Cannot open configured Data Summary');}var sheet=book.getSheetByName(String(route.data_summary_tab));if(!sheet)throw ErrorService.create('TARGET_TAB_UNAVAILABLE','Missing configured tab');var headers=sheet.getRange(1,1,1,Math.max(sheet.getLastColumn(),1)).getValues()[0].map(String);var missing=required.filter(function(h){return headers.indexOf(h)<0;});if(missing.length)throw ErrorService.create('CONFIGURATION_ERROR','Data Summary headers missing: '+missing.join(','));return {sheet:sheet,headers:headers};}
  function verify(route){target_(route);return true;}
  function upsert(record,route){var t=target_(route);var values=t.sheet.getDataRange().getValues();var row={submission_id:record.submission_id,submission_version:record.submission_version,updated_at:record.updated_at,updated_by:record.updated_by};Object.keys(record.metadata).forEach(function(k){row[k]=record.metadata[k];});var serialized=t.headers.map(function(h){return row[h]===undefined?'':row[h];});for(var i=1;i<values.length;i++){if(String(values[i][t.headers.indexOf('submission_id')])===record.submission_id){t.sheet.getRange(i+1,1,1,serialized.length).setValues([serialized]);return {action:'UPDATED',row:i+1};}}t.sheet.appendRow(serialized);return {action:'CREATED',row:t.sheet.getLastRow()};}
  function remove(submissionId,route){var t=target_(route);var values=t.sheet.getDataRange().getValues();var column=t.headers.indexOf('submission_id');for(var i=values.length-1;i>=1;i--){if(String(values[i][column])===submissionId)t.sheet.deleteRow(i+1);}}
  return {verify:verify,upsert:upsert,remove:remove,requiredHeaders:function(){return required.slice();}};
})();
