var DriveRepository=(function(){
  function folder_(id){try{return DriveApp.getFolderById(String(id));}catch(e){throw ErrorService.create('DRIVE_FOLDER_UNAVAILABLE','Cannot access configured folder');}}
  function verify(id){folder_(id);return true;}
  function saveFiles(submissionId,files,folderId,user){var folder=folder_(folderId);var saved=[];files.forEach(function(f){try{var bytes=Utilities.base64Decode(String(f.dataBase64).replace(/^data:[^;]+;base64,/,''));var blob=Utilities.newBlob(bytes,String(f.type),String(f.name));var file=folder.createFile(blob);file.setDescription('ChatCST submission '+submissionId);var item={submission_file_id:uuid_(),submission_id:submissionId,drive_file_id:file.getId(),original_filename:f.name,stored_filename:file.getName(),mime_type:f.type,size_bytes:f.size,folder_id:folderId,uploaded_at:nowIso_(),uploaded_by:user.email,active:true};AccessControlRepository.appendObject('SubmissionFiles',item);saved.push(item);AuditRepository.record('FILE_UPLOADED',user.email,submissionId,null,item,{driveFileId:file.getId()},'SUCCESS','');}catch(e){throw ErrorService.create('DRIVE_UPLOAD_FAILED','Upload failed for '+String(f.name));}});return saved;}
  function moveFiles(submissionId,newFolderId,user){var folder=folder_(newFolderId);var rows=AccessControlRepository.readTable('SubmissionFiles').filter(function(r){return r.submission_id===submissionId&&String(r.active).toLowerCase()==='true';});rows.forEach(function(r){var file=DriveApp.getFileById(String(r.drive_file_id));var before=r.folder_id;file.moveTo(folder);AuditRepository.record('FILE_MOVED',user.email,submissionId,{folderId:before},{folderId:newFolderId},{driveFileId:r.drive_file_id},'SUCCESS','');});return rows.length;}
  function deactivateFiles(submissionId,fileIds,user){if(!fileIds||!fileIds.length)return 0;var sheet=AccessControlRepository.controlBook().getSheetByName('SubmissionFiles');var values=sheet.getDataRange().getValues();var headers=values[0].map(String);var submissionCol=headers.indexOf('submission_id'),fileCol=headers.indexOf('drive_file_id'),activeCol=headers.indexOf('active'),count=0;for(var i=1;i<values.length;i++){if(String(values[i][submissionCol])===submissionId&&fileIds.indexOf(String(values[i][fileCol]))>=0&&String(values[i][activeCol]).toLowerCase()==='true'){sheet.getRange(i+1,activeCol+1).setValue(false);AuditRepository.record('FILE_REPLACED',user.email,submissionId,{driveFileId:values[i][fileCol],active:true},{driveFileId:values[i][fileCol],active:false},{retainedInDrive:true},'SUCCESS','');count++;}}return count;}
  return {verify:verify,saveFiles:saveFiles,moveFiles:moveFiles,deactivateFiles:deactivateFiles};
})();
