var AccessControlService=(function(){
  function desired_(){var assignments=AccessControlRepository.readTable('RoleAssignments').filter(function(r){return String(r.active).toLowerCase()==='true';});var matrix=AccessControlRepository.readTable('FolderAccessMatrix').filter(function(r){return String(r.active).toLowerCase()==='true';});var grants=[];assignments.forEach(function(a){matrix.filter(function(m){return String(m.role_id)===String(a.role_id);}).forEach(function(m){grants.push({email:normalizeEmail_(a.employee_email),folderId:String(m.folder_id),permission:String(m.permission).toUpperCase()});});});return grants;}
  function current_(folderIds){var grants=[];folderIds.forEach(function(id){try{var result=Drive.Permissions.list(id,{fields:'permissions(id,emailAddress,role,type)'});(result.permissions||[]).filter(function(p){return p.type==='user'&&p.emailAddress;}).forEach(function(p){grants.push({email:normalizeEmail_(p.emailAddress),folderId:id,permission:p.role==='writer'?'EDITOR':'VIEWER',permissionId:p.id});});}catch(e){throw ErrorService.create('ACL_SYNC_FAILED','Cannot read permissions for '+id);}});return grants;}
  function diff_(){var desired=desired_();var folderIds=[].filter.call(desired.map(function(g){return g.folderId;}),function(v,i,a){return a.indexOf(v)===i;});var current=current_(folderIds);var wanted={};desired.forEach(function(g){wanted[g.folderId+':'+g.email]=g;});var existing={};current.forEach(function(g){existing[g.folderId+':'+g.email]=g;});var protectedEmails=ConfigService.protectedEmails();var result={add:[],change:[],remove:[],protected:[]};desired.forEach(function(g){var c=existing[g.folderId+':'+g.email];if(!c)result.add.push(g);else if(c.permission!==g.permission)result.change.push(Object.assign({},g,{permissionId:c.permissionId}));});current.forEach(function(g){if(!wanted[g.folderId+':'+g.email]){if(protectedEmails.indexOf(g.email)>=0||ConfigService.get('ALLOW_ACL_REMOVAL')!=='true')result.protected.push(g);else result.remove.push(g);}});return result;}
  function preview(){AuthService.authorize(true);return diff_();}
  function sync(){var user=AuthService.authorize(true);var diff=diff_();AuditRepository.record('ACL_SYNC_STARTED',user.email,'',null,null,{counts:{add:diff.add.length,change:diff.change.length,remove:diff.remove.length}},'SUCCESS','');try{diff.add.forEach(function(g){Drive.Permissions.create({type:'user',role:g.permission==='EDITOR'?'writer':'reader',emailAddress:g.email},g.folderId,{sendNotificationEmail:false});AuditRepository.record('ACL_ADDED',user.email,'',null,g,{},'SUCCESS','');});diff.change.forEach(function(g){Drive.Permissions.update({role:g.permission==='EDITOR'?'writer':'reader'},g.folderId,g.permissionId);AuditRepository.record('ACL_CHANGED',user.email,'',null,g,{},'SUCCESS','');});diff.remove.forEach(function(g){Drive.Permissions.remove(g.folderId,g.permissionId);AuditRepository.record('ACL_REMOVED',user.email,'',g,null,{},'SUCCESS','');});AuditRepository.record('ACL_SYNC_COMPLETED',user.email,'',null,null,{counts:{add:diff.add.length,change:diff.change.length,remove:diff.remove.length}},'SUCCESS','');return diff;}catch(e){AuditRepository.record('ACL_SYNC_COMPLETED',user.email,'',null,null,{},'FAILURE','ACL_SYNC_FAILED');throw ErrorService.create('ACL_SYNC_FAILED',e.message);}}
  return {preview:preview,sync:sync};
})();
